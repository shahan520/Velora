rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Server-verified administrator role check
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // --- 1. User Profiles Collection ---
    // Enforces least-privilege: ordinary users cannot change their own role, verification,
    // premium entitlement, payment status, or moderation status.
    match /users/{userId} {
      // Authenticated users can view member profiles for dating discovery
      allow read: if isAuthenticated();
      
      // User can create their initial profile, but CANNOT self-grant privileged attributes
      allow create: if isOwner(userId)
        && request.resource.data.role == 'USER'
        && request.resource.data.isVerified == false
        && request.resource.data.isPremium == false
        && request.resource.data.paymentStatus == 'none'
        && request.resource.data.isSuspended == false;
      
      // Profile updates: Ordinary users can modify non-privileged fields (bio, photos, interests)
      // but are strictly forbidden from modifying privileged security fields.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isVerified', 'isPremium', 'paymentStatus', 'isSuspended', 'moderationStatus'
      ])) || isAdmin();
      
      // Deletions allowed by owner or administrator
      allow delete: if isOwner(userId) || isAdmin();
    }

    // --- 2. Private Conversations & Chat Messages ---
    // Strictly accessible ONLY to eligible participants in the match.
    match /conversations/{conversationId} {
      // Only conversation participants or administrators (in safety audits) can access
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );
      
      // Conversations can only be initiated by matched participants
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      
      // Updates permitted only to participants
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );
      
      allow delete: if isAdmin();

      // Individual messages within the conversation
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
          isAdmin()
        );
        
        // Sender must be an authorized participant and cannot forge senderId
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
          
        allow update, delete: if isAdmin();
      }
    }

    // --- 3. User Safety Reports ---
    // Users can report abusive behavior; reports are readable only by reporter and admins
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- 4. Protected Admin Data & Platform Analytics ---
    // Ordinary users are completely denied access
    match /admin_data/{document=**} {
      allow read, write: if isAdmin();
    }

    // --- 5. Immutable Audit Logs ---
    // Writeable ONLY by trusted server backend code. Readable only by admins.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only trusted server / Cloud Functions with Admin SDK
    }

    // --- 6. Payment Receipts & Subscription Entitlements ---
    // Verified by server payment webhook / backend only.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Clients cannot create or alter payment records directly
    }
  }
}
